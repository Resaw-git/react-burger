PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=stellar_burgers

JWT_SECRET=
JWT_ACCESS_EXPIRES=20m
JWT_REFRESH_EXPIRES=30d

# true — Redis (нужен контейнер: docker compose up redis), false — in-memory
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting: limit запросов за THROTTLE_TTL_MS; отдельно для auth/password-reset
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
THROTTLE_AUTH_LIMIT=20

# Отправка писем: false — логирование в консоль вместо SMTP
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Stellar Burgers <noreply@example.ru>"
